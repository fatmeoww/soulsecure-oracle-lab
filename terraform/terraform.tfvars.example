# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored -- never commit it, it can contain your
# real IP and SSH public key.

region = "ap-singapore-1"    # pick whatever region you set up during OCI signup

# Find with: oci iam compartment list --compartment-id-in-subtree true
# (your tenancy's root compartment OCID is fine for a personal account)
compartment_ocid = "ocid1.compartment.oc1..aaaaaaaa...your-compartment-here"

# Your own IP, restricting who can reach web-01 at all.
# Find it with: curl -s https://checkip.amazonaws.com
allowed_cidr = "203.0.113.4/32"

# Contents of your own SSH *public* key (never the private key).
# e.g.: cat ~/.ssh/id_ed25519.pub
admin_ssh_public_key = "ssh-ed25519 AAAA...your-public-key-here... you@yourhost"

# Free DuckDNS domain pointed at web01_public_ip -- sign in at
# https://www.duckdns.org, add a subdomain, put it here. Point its A record
# at web01_public_ip once after your first apply; it stays valid after that
# since web01_public_ip is a reserved (not ephemeral) IP -- see compute.tf.
duckdns_domain = "soulsecure.duckdns.org"

# Optional overrides (defaults shown):
# instance_shape  = "VM.Standard.E2.1.Micro"
# par_expiration  = "2030-01-01T00:00:00Z"
